#!/bin/bash
# Optional integration: missing browser, Python or helper never blocks theme switching.
helper="$HOME/.local/lib/omarchy-soulfly/zen-theme.py"
if command -v python3 >/dev/null 2>&1 && [[ -f "$helper" ]]; then
  python3 "$helper" "$@" || printf '%s\n' 'Soulfly Zen: optional sync skipped' >&2
fi
exit 0
